<Window x:Class="CadenceCisLibraryManager.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="760" Width="900" MinHeight="640" MinWidth="760"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="MariaDB 连接" Margin="0,0,0,12" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="服务器" VerticalAlignment="Center" Margin="0,0,8,8" />
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="ServerBox" Margin="0,0,12,8" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="端口" VerticalAlignment="Center" Margin="0,0,8,8" />
                        <TextBox Grid.Row="0" Grid.Column="3" x:Name="PortBox" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="数据库" VerticalAlignment="Center" Margin="0,0,8,8" />
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="DatabaseBox" Margin="0,0,12,8" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="用户" VerticalAlignment="Center" Margin="0,0,8,8" />
                        <TextBox Grid.Row="1" Grid.Column="3" x:Name="UserBox" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="密码" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <PasswordBox Grid.Row="2" Grid.Column="1" x:Name="PasswordBox" Margin="0,0,12,0" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="库路径" Margin="0,0,0,12" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="封装库" VerticalAlignment="Center" Margin="0,0,8,8" />
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="FootprintPathBox" Margin="0,0,8,8" />
                        <Button Grid.Row="0" Grid.Column="2" Content="浏览" Width="80" Margin="0,0,0,8" Click="BrowseFootprintPath_Click" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="符号库" VerticalAlignment="Center" Margin="0,0,8,8" />
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="SymbolPathBox" Margin="0,0,8,8" />
                        <Button Grid.Row="1" Grid.Column="2" Content="浏览" Width="80" Margin="0,0,0,8" Click="BrowseSymbolPath_Click" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="3D 模型库" VerticalAlignment="Center" Margin="0,0,8,8" />
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="Model3DPathBox" Margin="0,0,8,8" />
                        <Button Grid.Row="2" Grid.Column="2" Content="浏览" Width="80" Margin="0,0,0,8" Click="BrowseModel3DPath_Click" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="焊盘/引脚库" VerticalAlignment="Center" Margin="0,0,8,8" />
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="PinPathBox" Margin="0,0,8,8" />
                        <Button Grid.Row="3" Grid.Column="2" Content="浏览" Width="80" Margin="0,0,0,8" Click="BrowsePinPath_Click" />
                        <CheckBox Grid.Row="4" Grid.Column="1" x:Name="StoreFileNameCheckBox" Content="数据库仅保存文件名" IsChecked="True" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="数据库字段名" Margin="0,0,0,12" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Part Number 字段" VerticalAlignment="Center" Margin="0,0,8,8" />
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="PartNumberColumnsBox" Margin="0,0,0,8" ToolTip="多个字段名用逗号分隔" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="封装字段" VerticalAlignment="Center" Margin="0,0,8,8" />
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="FootprintColumnsBox" Margin="0,0,0,8" ToolTip="多个字段名用逗号分隔" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="符号字段" VerticalAlignment="Center" Margin="0,0,8,8" />
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="SymbolColumnsBox" Margin="0,0,0,8" ToolTip="多个字段名用逗号分隔" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="3D 字段" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="Model3DColumnsBox" ToolTip="多个字段名用逗号分隔" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="Part Number 前缀" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="ID 位数" VerticalAlignment="Center" Margin="0,0,8,8" />
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="PartNumberIdWidthBox" Width="120" HorizontalAlignment="Left" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="表前缀" VerticalAlignment="Center" Margin="0,0,8,8" />
                        <Button Grid.Row="1" Grid.Column="1" Content="刷新表名" Width="90" HorizontalAlignment="Left" Margin="0,0,0,8" Click="RefreshTablePrefixes_Click" />
                        <DataGrid Grid.Row="2" Grid.Column="1" x:Name="TablePrefixesGrid" Height="180" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="表名" Binding="{Binding TableName, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                <DataGridTextColumn Header="前缀" Binding="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}" Width="160" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="保存" Width="90" Margin="0,0,8,0" Click="Save_Click" />
            <Button Content="取消" Width="90" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
