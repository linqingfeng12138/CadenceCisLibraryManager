<Window x:Class="CadenceCisLibraryManager.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于" Height="480" Width="620" MinHeight="420" MinWidth="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="OrCAD CIS 库管理器" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12" />

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="软件名称" FontWeight="SemiBold" Margin="0,0,8,8" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="OrCAD CIS 库管理器" Margin="0,0,0,8" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="当前版本" FontWeight="SemiBold" Margin="0,0,8,8" />
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="VersionText" Margin="0,0,0,8" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="作者" FontWeight="SemiBold" Margin="0,0,8,0" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="linqingfeng" />
                </Grid>

                <GroupBox Header="使用的开源代码 / 第三方组件" Padding="12">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">
                            本软件使用 .NET/WPF 构建，并引用以下开源组件或平台技术：
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">
                            • .NET / WPF：Microsoft 提供的应用程序框架和桌面 UI 技术。
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">
                            • MySqlConnector 2.4.0：用于连接 MariaDB/MySQL 数据库的开源 .NET 数据库驱动，许可证为 MIT License。
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap">
                            除上述组件外，当前项目未发现其它 NuGet 第三方包引用。各组件版权与许可证归其原作者或维护者所有。
                        </TextBlock>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="1" Content="关闭" Width="90" HorizontalAlignment="Right" Margin="0,14,0,0" IsCancel="True" />
    </Grid>
</Window>
