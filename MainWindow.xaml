<Window x:Class="CadenceCisLibraryManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OrCAD CIS 库管理器" Height="820" Width="1180" MinHeight="700" MinWidth="1000"
        Loaded="Window_Loaded">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="封装文件" VerticalAlignment="Center" Margin="0,0,8,8" />
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="FootprintFilesBox" IsReadOnly="True" Margin="0,0,8,8" ToolTip="请选择 Allegro 封装 .psm 与 .dra 文件" />
                <Button Grid.Row="0" Grid.Column="2" Content="浏览" Width="90" Margin="0,0,0,8" Click="BrowseFootprintFiles_Click" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="源符号库" VerticalAlignment="Center" Margin="0,0,8,8" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="SourceSymbolLibraryBox" IsReadOnly="True" Margin="0,0,8,8" ToolTip="选择需要打开的源 .olb 符号库" />
                <Button Grid.Row="1" Grid.Column="2" Content="浏览" Width="90" Margin="0,0,12,8" Click="BrowseSourceSymbolLibrary_Click" />
                <TextBlock Grid.Row="1" Grid.Column="3" Text="目标符号库" VerticalAlignment="Center" Margin="0,0,8,8" />
                <ComboBox Grid.Row="1" Grid.Column="4" x:Name="TargetSymbolLibraryComboBox" Margin="0,0,8,8" SelectionChanged="TargetSymbolLibrary_SelectionChanged" />
                <Button Grid.Row="1" Grid.Column="5" Content="刷新" Width="70" Margin="0,0,8,8" Click="RefreshSymbolLibraries_Click" />
                <Button Grid.Row="1" Grid.Column="6" Content="打开文件夹" Width="100" Margin="0,0,0,8" Click="OpenSymbolLibraryFolders_Click" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="3D 模型文件" VerticalAlignment="Center" Margin="0,0,8,8" />
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="Model3DFileBox" IsReadOnly="True" Margin="0,0,8,8" />
                <Button Grid.Row="2" Grid.Column="2" Content="浏览" Width="90" Margin="0,0,0,8" Click="BrowseModel3DFile_Click" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="焊盘/引脚文件" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="PinFileBox" IsReadOnly="True" Margin="0,0,8,0" ToolTip="选择 Allegro Padstack 与 Library 文件：.pad/.osm/.bsm/.fsm/.ssm" />
                <Button Grid.Row="3" Grid.Column="2" Content="浏览" Width="90" Click="BrowsePinFile_Click" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="SettingsButton" Content="设置" Width="90" Margin="0,0,8,0" Click="Settings_Click" />
            <Button x:Name="TestConnectionButton" Content="测试连接" Width="90" Margin="0,0,16,0" Click="TestConnection_Click" />
            <Button x:Name="RefreshTablesButton" Content="读取表" Width="90" Margin="0,0,8,0" Click="RefreshTables_Click" />
            <ComboBox x:Name="TableComboBox" Width="260" Margin="0,0,8,0" SelectionChanged="TableComboBox_SelectionChanged" />
            <Button x:Name="LoadColumnsButton" Content="生成表单" Width="90" Margin="0,0,8,0" Click="LoadColumns_Click" />
            <Button x:Name="GenerateNumberButton" Content="更新编号" Width="90" Margin="0,0,8,0" Click="GenerateNumber_Click" />
            <Button x:Name="SubmitButton" Content="提交入库" Width="100" Margin="0,0,8,0" Click="Submit_Click" />
            <Button x:Name="AboutButton" Content="关于" Width="90" Click="About_Click" />
        </StackPanel>

        <Border Grid.Row="2" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="6" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="FormPanel" />
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="3" x:Name="StatusText" Margin="0,12,0,0" Foreground="#444444" Text="请先在设置中填写 MariaDB 与库路径，然后浏览文件并生成表单。" TextWrapping="Wrap" />
    </Grid>
</Window>
