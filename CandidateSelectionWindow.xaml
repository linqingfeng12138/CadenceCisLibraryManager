<Window x:Class="CadenceCisLibraryManager.CandidateSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择候选值" Height="560" Width="520" MinHeight="480" MinWidth="420"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="搜索" Margin="0,0,0,6" />
            <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" />
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="6" Padding="8">
            <ListBox x:Name="CandidatesListBox" SelectionMode="Extended"
                     DisplayMemberPath="Value" />
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Width="90" Margin="0,0,8,0" Click="Confirm_Click" IsDefault="True">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource SymbolTextStyle}" Text="&#xE73E;" />
                    <TextBlock Text="确定" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Width="90" IsCancel="True">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource SymbolTextStyle}" Text="&#xE711;" />
                    <TextBlock Text="取消" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
